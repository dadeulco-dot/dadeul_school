+// 끝의 따옴표 · 괄호 · 공백은 건너뛰고, 숫자 · 영문은 읽는 소리로 봅니다(1 일, 3 삼, L 엘, M 엠 …).
+type Pair = "을/를" | "이/가" | "은/는" | "과/와" | "으로/로" | "이에요/예요";
+const NUM_JONG: Record<string, number> = { "0": 21, "1": 8, "2": 0, "3": 16, "4": 0, "5": 0, "6": 1, "7": 8, "8": 8, "9": 0 };
+const LATIN_JONG: Record<string, number> = { l: 8, m: 16, n: 4, r: 8 };
+function jong(word: string): number {
+  const t = word.replace(/[\s」』’”"')\]⁠.,!?]+$/u, "");
+  const ch = t.slice(-1);
+  const code = ch.charCodeAt(0);
+  if (code >= 0xac00 && code <= 0xd7a3) return (code - 0xac00) % 28;
+  if (ch in NUM_JONG) return NUM_JONG[ch];
+  return LATIN_JONG[ch.toLowerCase()] ?? 0;
+}
+export function josa(word: string, pair: Pair): string {
+  const [withJong, noJong] = pair.split("/");
+  const j = jong(word);
+  if (pair === "으로/로") return j === 0 || j === 8 ? noJong : withJong; // ㄹ 받침 뒤에는 「로」
+  return j === 0 ? noJong : withJong;
+}
